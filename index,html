<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para ti</title>
    <style>
        body {
            margin: 0;
            height: 100vh;
            background-color: #0f172a;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
            flex-direction: column;
        }

        .heart-container {
            position: relative;
            width: 150px;
            height: 150px;
            animation: latido 1.2s infinite;
        }

        .heart {
            position: absolute;
            width: 100px;
            height: 160px;
            background: #ff3366;
            border-top-left-radius: 50px;
            border-top-right-radius: 50px;
            box-shadow: 0 0 50px rgba(255, 51, 102, 0.6);
        }

        .heart.left {
            left: 50px;
            transform: rotate(-45deg);
            transform-origin: 0 100%;
        }

        .heart.right {
            left: 0;
            transform: rotate(45deg);
            transform-origin: 100% 100%;
        }

        @keyframes latido {
            0% { transform: scale(1); }
            15% { transform: scale(1.25); }
            30% { transform: scale(1); }
            45% { transform: scale(1.15); }
            60% { transform: scale(1); }
        }

        #text-change {
            margin-top: 50px;
            color: #ffffff;
            font-size: 1.8rem;
            font-weight: bold;
            text-align: center;
            min-height: 50px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.5);
            padding: 0 20px;
            letter-spacing: 1px;
            animation: fadeIn 0.8s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="heart-container">
        <div class="heart left"></div>
        <div class="heart right"></div>
    </div>

    <div id="text-change">Cargando...</div>

    <script>
        const mensajes = [
            "Eres una persona increíble",
            "Me encantas muchísimo",
            "Siempre alegras mis días",
            "Gracias por existir",
            "Te quiero un montón"
        ];

        let index = 0;
        const textElement = document.getElementById("text-change");

        function cambiarTexto() {
            textElement.style.opacity = 0;
            setTimeout(() => {
                textElement.textContent = mensajes[index];
                textElement.style.opacity = 1;
                index = (index + 1) % mensajes.length;
            }, 400);
        }

        cambiarTexto();
        setInterval(cambiarTexto, 3000);
    </script>
</body>
</html>
